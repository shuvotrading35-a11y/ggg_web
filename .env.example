# =============================================
# Shuvo Hosting Bot — Environment Configuration
# =============================================

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin Telegram IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Master key for Token Vault encryption (generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MASTER_KEY=your_fernet_key_here

# Base hosting directory
HOSTING_DIR=/opt/shuvo-hosting/storage/bots

# Database path
DATABASE_URL=sqlite:////opt/shuvo-hosting/data/hosting.db

# Max file upload size in MB
MAX_UPLOAD_SIZE_MB=50

# Max ZIP file size in MB
MAX_ZIP_SIZE_MB=100

# Auto-restart max attempts within window
MAX_RESTART_ATTEMPTS=5
RESTART_WINDOW_MINUTES=10

# Log retention lines
LOG_TAIL_LINES=50

# Performance history retention days
PERF_HISTORY_DAYS=30

# Webhook base URL (optional, leave empty for polling only)
WEBHOOK_BASE_URL=

# Log level
LOG_LEVEL=INFO
